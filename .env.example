# ============================================================================
# Dopshy WhatsApp bot — environment template. Copy to `.env` and fill in.
#   cp .env.example .env
# Values here are placeholders/defaults; never commit the real .env.
# ============================================================================

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── WhatsApp Cloud API (three bots share one WHATSAPP_TOKEN) ─────────────────
WHATSAPP_TOKEN=your-meta-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID_BOT_1=000000000000000
WHATSAPP_PHONE_NUMBER_ID_BOT_2=000000000000000
WHATSAPP_PHONE_NUMBER_ID_BOT_3=000000000000000
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# ── YCloud (outbound WhatsApp for Bot 1) ─────────────────────────────────────
YCLOUD_API_KEY=your-ycloud-api-key
YCLOUD_FROM_BOT_1=+10000000000

# ── PostgreSQL (single source of truth for bookings) ────────────────────────
# Inside Docker the host is the `postgres` service name.
POSTGRES_DSN=postgresql://dopshy:changeme@postgres:5432/dopshy
POSTGRES_PASSWORD=changeme
POSTGRES_MAX_CONN=10

# ── Redis (ephemeral message-batch buffer) ───────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Service token (backend ↔ bot manager API) ───────────────────────────────
# The bot's /api/manager/* endpoints require this as the X-API-Key header.
# The backend must set MANAGER_API_KEY to this SAME value.
X_SERVICE_TOKEN=change_this_to_a_long_random_string
MANAGER_RATE_LIMIT=60

# ── Edge nginx + Let's Encrypt (single reverse proxy for the whole server) ──
# This project's nginx owns ports 80/443 and terminates TLS for BOTH the bot
# and the backend, routing by domain. Both domains must point (DNS A record)
# at this server.
SERVER_NAME=bot.dopsy.kz          # bot / WhatsApp webhooks -> bot:5000
API_SERVER_NAME=api.dopsy.kz      # backend API             -> backend_app:8000
CERTBOT_EMAIL=admin@dopsy.kz      # Let's Encrypt expiry notices

# ── CORS (manager API) ───────────────────────────────────────────────────────
# Comma-separated origins, or * for all.
CORS_ALLOWED_ORIGINS=*

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change_this_to_a_random_string

# ── Google Sheets (opt-in — leave GOOGLE_SPREADSHEET_ID blank to disable) ────
GOOGLE_CREDENTIALS_PATH=./secrets/google_credentials.json
GOOGLE_SPREADSHEET_ID=
GOOGLE_WORKSHEET_NAME=Bookings

# ── Booking (Bot 1 — Dopshy field rental) ────────────────────────────────────
BOOKING_OPEN_TIME=00:00
BOOKING_CLOSE_TIME=23:59
BOOKING_SLOT_DURATION=60
BOOKING_FIELDS=[{"id":1,"format":"6x6"},{"id":2,"format":"5x5"},{"id":3,"format":"5x5"}]
BOOKING_TIMEZONE=Asia/Almaty
BOOKING_SESSION_TTL=1800
PAYMENT_TTL_SECONDS=1200
PAYMENT_MIN_FRACTION=0.5
PAYMENT_RECEIPT_MAX_AGE_HOURS=24
KASPI_PAYMENT_URL=https://pay.kaspi.kz/pay/xxxxxxxx
# Comma-separated YYYY-MM-DD dates that use weekend/holiday pricing.
HOLIDAYS=

# ── ApiPay.kz — online avans via Kaspi Pay (https://apipay.kz) ───────────────
# Both values come from the ApiPay dashboard → Настройки → «Подключение».
# Each is shown ONCE, on creation. Server-side only — never expose to a browser.
#   APIPAY_API_KEY        — «Создать новый ключ»
#   APIPAY_WEBHOOK_SECRET — «Создать подпись» on the same key card
# Leave both empty to keep the manual receipt flow (the integration self-disables).
APIPAY_API_KEY=
APIPAY_WEBHOOK_SECRET=
APIPAY_BASE_URL=https://api.apipay.kz/api/v1
APIPAY_TIMEOUT=10
# Avans charged per non-repeating booking in a bookings/batch request.
APIPAY_AVANS_PER_BOOKING=10000
# Check the number against Kaspi (POST /clients/check) before raising an invoice.
# Keep it on: an invoice to a number Kaspi does not know is accepted, spends one
# of the day's invoices, and fails later as a webhook — where neither the client
# nor the manager can be told. Set to 0 only if that endpoint itself misbehaves.
APIPAY_CHECK_CLIENT=1

# ── Paths / misc (defaults are fine for Docker) ──────────────────────────────
PORT=5000
CHROMA_DB_PATH=./chroma_db
DOCUMENTS_PATH=./documents
CONVERSATION_DB_PATH=./data/conversations.db
CHROMA_TELEMETRY=False
MESSAGE_BATCH_WINDOW_SECONDS=4

# ── Directus admin panel (shares the bot's PostgreSQL) ───────────────────────
# Generate KEY and SECRET with:  openssl rand -hex 32
DIRECTUS_KEY=
DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=admin@dopsy.kz
DIRECTUS_ADMIN_PASSWORD=change_this_to_a_strong_password
DIRECTUS_PUBLIC_URL=http://localhost:8055
